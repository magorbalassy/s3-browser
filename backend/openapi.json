  "components": {
    "schemas": {
      "BucketList": {
        "properties": {
          "buckets": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Buckets"
          }
        },
        "type": "object",
        "required": [
          "buckets"
        ],
        "title": "BucketList"
      },
      "ConnectRequest": {
        "properties": {
          "endpoint": {
            "type": "string",
            "maxLength": 2048,
            "title": "Endpoint",
            "description": "S3 endpoint URL, e.g. http://minio:9000. Empty means AWS S3.",
            "default": ""
          },
          "access_key": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Access Key"
          },
          "secret_key": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "format": "password",
            "title": "Secret Key",
            "writeOnly": true
          },
          "region": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Region",
            "default": "us-east-1"
          },
          "verify_tls": {
            "type": "boolean",
            "title": "Verify Tls",
            "description": "Verify the endpoint's TLS certificate. Disable only for trusted endpoints.",
            "default": true
          },
          "ca_cert": {
            "type": "string",
            "maxLength": 65536,
            "title": "Ca Cert",
            "description": "Extra CA certificate(s) in PEM format, trusted in addition to public CAs.",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "access_key",
          "secret_key"
        ],
        "title": "ConnectRequest"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Stable machine-readable error code."
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "ObjectPage": {
        "properties": {
          "bucket": {
            "type": "string",
            "title": "Bucket"
          },
          "prefix": {
            "type": "string",
            "title": "Prefix"
          },
          "folders": {
            "items": {
              "$ref": "#/components/schemas/S3Folder"
            },
            "type": "array",
            "title": "Folders"
          },
          "files": {
            "items": {
              "$ref": "#/components/schemas/S3File"
            },
            "type": "array",
            "title": "Files"
          },
          "next_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Token",
            "description": "Pass as `token` to fetch the next page; null on the last page."
          }
        },
        "type": "object",
        "required": [
          "bucket",
          "prefix",
          "folders",
          "files"
        ],
        "title": "ObjectPage"
      },
      "S3File": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          },
          "last_modified": {
            "type": "string",
            "format": "date-time",
            "title": "Last Modified"
          },
          "storage_class": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Storage Class"
          }
        },
        "type": "object",
        "required": [
          "key",
          "name",
