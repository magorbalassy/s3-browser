        "summary": "Folder Size",
        "description": "Stream the running size of everything under `prefix` as Server-Sent Events.",
        "operationId": "folder_size",
        "parameters": [
          {
            "name": "bucket",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
